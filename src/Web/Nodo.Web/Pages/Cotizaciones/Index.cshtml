@page
@model Nodo.Web.Pages.Cotizaciones.IndexModel
@using Nodo.Cotizaciones.Domain
@{
    ViewData["Title"] = "Cotizaciones";
    var ahora = DateTime.UtcNow;
}

<div class="nodo-encabezado d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1>Cotizaciones</h1>
        <p>Una cotización (o presupuesto) es una propuesta con vigencia: conserva su precio, pero no reserva nada.</p>
    </div>
    <span class="nodo-codigo">INV-03 · INV-04 · INV-05</span>
</div>

@if (Model.Mensaje != null)
{
    <div class="alert alert-success">@Model.Mensaje</div>
}
@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">Emitir cotización</div>
            <div class="card-body">
                <form method="post" asp-page-handler="Emitir">
                    <div class="mb-3">
                        <label for="clienteId" class="form-label">Cliente</label>
                        <select id="clienteId" name="clienteId" class="form-select">
                            @foreach (var c in CatalogoDemo.Clientes)
                            {
                                <option value="@c.Id">@c.Nombre — @c.Plan</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="recursoId" class="form-label">Recurso</label>
                        <select id="recursoId" name="recursoId" class="form-select">
                            @foreach (var r in CatalogoDemo.Recursos)
                            {
                                <option value="@r.Id">@r.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-5">
                            <label for="horas" class="form-label">Horas</label>
                            <input id="horas" name="horas" type="number" min="1" max="14" class="form-control" value="6" required />
                        </div>
                        <div class="col-7">
                            <label for="fechaHoraInicio" class="form-label">Inicio</label>
                            <input id="fechaHoraInicio" name="fechaHoraInicio" type="datetime-local" class="form-control"
                                   value="@DateTime.Today.AddDays(1).AddHours(10).ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Emitir</button>
                    <p class="text-secondary small mt-3 mb-0">El precio lo calcula Cálculo de precio total y queda fijo durante la vigencia (INV-04).</p>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <span>Cotizaciones</span>
                <span class="text-secondary small fw-normal">@Model.Cotizaciones.Count en total</span>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Cliente / recurso</th>
                            <th class="text-end text-nowrap">Precio ofrecido</th>
                            <th>Vigencia</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Cotizaciones.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-secondary py-4">Todavía no hay cotizaciones.</td></tr>
                        }
                        @foreach (var c in Model.Cotizaciones)
                        {
                            var vencida = !c.Vigencia.EstaVigente(ahora);
                            <tr>
                                <td>
                                    <div class="fw-semibold">@CatalogoDemo.NombreCliente(c.ClienteId)</div>
                                    <div class="text-secondary small">@CatalogoDemo.NombreRecurso(c.RecursoId)</div>
                                </td>
                                <td class="text-end fw-semibold">@Formato.Importe(c.PrecioOfrecido)</td>
                                <td class="small text-nowrap">
                                    <div>Emitida @Formato.Fecha(c.Vigencia.Emision)</div>
                                    <div class="@(vencida ? "text-danger" : "text-secondary")">Vence @Formato.Fecha(c.Vigencia.Vencimiento)</div>
                                </td>
                                <td>
                                    @switch (c.Estado)
                                    {
                                        case EstadoCotizacion.Aceptada:
                                            <span class="badge text-bg-success">Aceptada</span>
                                            break;
                                        case EstadoCotizacion.Caducada:
                                            <span class="badge text-bg-secondary">Caducada</span>
                                            break;
                                        default:
                                            <span class="badge text-bg-primary">Emitida</span>
                                            if (vencida)
                                            {
                                                <div class="small text-danger mt-1">plazo vencido</div>
                                            }
                                            break;
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (c.Estado == EstadoCotizacion.Emitida)
                                    {
                                        <form method="post" asp-page-handler="Aceptar" class="d-inline">
                                            <input type="hidden" name="cotizacionId" value="@c.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary"
                                                    title="@(vencida ? "Está vencida: el dominio la rechazará (INV-05)" : "Aceptar dentro de la vigencia")">Aceptar</button>
                                        </form>
                                        @if (vencida)
                                        {
                                            <form method="post" asp-page-handler="Caducar" class="d-inline">
                                                <input type="hidden" name="cotizacionId" value="@c.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Registrar caducidad</button>
                                            </form>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
