@page
@model Nodo.Web.Pages.Calculo.IndexModel
@{
    ViewData["Title"] = "Simular Cálculo";
}

<h2>Simular Cálculo de Precio Total</h2>

<form method="post">
    <div>
        <label>RecursoId</label>
        <input name="recursoId" value="aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa" />
    </div>
    <div>
        <label>Horas</label>
        <input name="horas" type="number" value="6" />
    </div>
    <div>
        <label>Fecha/Hora Inicio</label>
        <input name="fechaHoraInicio" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
    </div>
    <div>
        <label>ClienteId (para plan)</label>
        <input name="clienteId" value="11111111-1111-1111-1111-111111111111" />
    </div>
    <button type="submit">Calcular</button>
</form>

@if (Model.Desglose != null)
{
    <h3>Desglose</h3>
    <ul>
        <li>Horas solicitadas: @Model.Desglose.HorasSolicitadas</li>
        <li>Horas cubiertas: @Model.Desglose.HorasCubiertas</li>
        <li>Horas adicionales: @Model.Desglose.HorasAdicionales</li>
        <li>Importe horas adicionales bruto: @Model.Desglose.ImporteHorasAdicionalesBruto.Amount @Model.Desglose.ImporteHorasAdicionalesBruto.Currency</li>
        <li>Descuento aplicado: @Model.Desglose.DescuentoAplicadoPorcentaje %</li>
        <li>Importe horas adicionales neto: @Model.Desglose.ImporteHorasAdicionalesNeto.Amount @Model.Desglose.ImporteHorasAdicionalesNeto.Currency</li>
        <li>Precio total: @Model.Desglose.PrecioTotal.Amount @Model.Desglose.PrecioTotal.Currency</li>
        <li>Facturable: @Model.Desglose.Facturable</li>
    </ul>
}
@if (Model.Error != null)
{
    <p style="color:red">@Model.Error</p>
}
