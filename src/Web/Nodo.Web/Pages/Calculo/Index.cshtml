@page
@model Nodo.Web.Pages.Calculo.IndexModel
@{
    ViewData["Title"] = "Cálculo de precio";
    var d = Model.Desglose;
}

<div class="nodo-encabezado d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1>Cálculo de precio total</h1>
        <p>Simula cuánto cuesta una operación. Calcular no reserva, no consume horas del plan ni factura.</p>
    </div>
    <span class="nodo-codigo">INV-06 · INV-07 · R-02</span>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">Operación</div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label for="recursoId" class="form-label">Recurso</label>
                        <select id="recursoId" name="recursoId" class="form-select">
                            @foreach (var r in CatalogoDemo.Recursos)
                            {
                                <option value="@r.Id" selected="@(r.Id == Model.RecursoId)">@r.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="clienteId" class="form-label">Cliente</label>
                        <select id="clienteId" name="clienteId" class="form-select">
                            @foreach (var c in CatalogoDemo.Clientes)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.ClienteId)">@c.Nombre — @c.Plan</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-5">
                            <label for="horas" class="form-label">Horas</label>
                            <input id="horas" name="horas" type="number" min="1" max="14" class="form-control" value="@Model.Horas" required />
                        </div>
                        <div class="col-7">
                            <label for="fechaHoraInicio" class="form-label">Inicio</label>
                            <input id="fechaHoraInicio" name="fechaHoraInicio" type="datetime-local" class="form-control"
                                   value="@Model.FechaHoraInicio.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Calcular precio</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        @if (Model.Error != null)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }
        @if (d != null)
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Desglose</span>
                    @if (d.Facturable)
                    {
                        <span class="badge text-bg-warning">Genera consumo facturable</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success">Cubierto por el plan</span>
                    }
                </div>
                <div class="card-body">
                    <div class="row text-center mb-4">
                        <div class="col"><div class="fs-3 fw-bold">@d.HorasSolicitadas</div><div class="text-secondary small">horas solicitadas</div></div>
                        <div class="col"><div class="fs-3 fw-bold text-success">@d.HorasCubiertas</div><div class="text-secondary small">cubiertas por el plan</div></div>
                        <div class="col"><div class="fs-3 fw-bold text-warning">@d.HorasAdicionales</div><div class="text-secondary small">horas extra</div></div>
                    </div>
                    <table class="table table-sm mb-3">
                        <tbody>
                            <tr><td>Horas cubiertas</td><td class="text-end">@Formato.Importe(d.ImporteHorasCubiertas)</td></tr>
                            <tr><td>Horas extra (bruto)</td><td class="text-end">@Formato.Importe(d.ImporteHorasAdicionalesBruto)</td></tr>
                            <tr><td>Descuento del plan</td><td class="text-end">@d.DescuentoAplicadoPorcentaje.ToString("0.##") %</td></tr>
                            <tr><td>Horas extra (neto)</td><td class="text-end">@Formato.Importe(d.ImporteHorasAdicionalesNeto)</td></tr>
                        </tbody>
                    </table>
                    <div class="d-flex justify-content-between align-items-baseline border-top pt-3">
                        <span class="fw-semibold">Precio total</span>
                        <span class="nodo-total">@Formato.Importe(d.PrecioTotal)</span>
                    </div>
                </div>
            </div>
        }
        else if (Model.Error == null)
        {
            <div class="card h-100">
                <div class="card-body text-secondary d-flex align-items-center justify-content-center text-center">
                    Elige un recurso, un cliente y las horas.<br />El desglose aparecerá aquí.
                </div>
            </div>
        }
    </div>
</div>
