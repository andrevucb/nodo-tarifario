@using Nodo.Web.Infrastructure
@inject DomainEventToastNotifications DomainEventToasts
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Nodo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Nodo.Web.styles.css" asp-append-version="true" />
</head>
@{
    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Activa(string prefijo) => paginaActual.StartsWith(prefijo) ? "active" : "";
    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark nodo-navbar mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-baseline gap-2" asp-page="/Index">
                    <span class="fw-bold">Nodo</span>
                    <span class="nodo-brand-sub">Tarifas y precios</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @Activa("/Tarifario")" asp-page="/Tarifario/Index">Tarifario</a></li>
                        <li class="nav-item"><a class="nav-link @Activa("/Calculo")" asp-page="/Calculo/Index">Cálculo de precio</a></li>
                        <li class="nav-item"><a class="nav-link @Activa("/Cotizaciones")" asp-page="/Cotizaciones/Index">Cotizaciones</a></li>
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-white-50 small">@User.Identity.Name</span>
                            <span class="badge @(rol == "Direccion" ? "text-bg-warning" : "text-bg-light")">@(rol == "Direccion" ? "Dirección" : rol)</span>
                            <form method="post" asp-page="/Login" asp-page-handler="Salir" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-light">Salir</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-light" asp-page="/Login">Iniciar sesión</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    @if (DomainEventToasts.Notifications.Count > 0)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" aria-live="polite" aria-atomic="true">
            @foreach (var notification in DomainEventToasts.Notifications)
            {
                <div class="toast" role="status" data-bs-autohide="true">
                    <div class="toast-header">
                        <strong class="me-auto">@notification.Title</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                    </div>
                    <div class="toast-body">@notification.Message</div>
                </div>
            }
        </div>
    }

    <footer class="border-top footer text-muted small">
        <div class="container">
            Nodo · subdominio Tarifas y precios · Maestría DDD 2026
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.toast').forEach(element => bootstrap.Toast.getOrCreateInstance(element).show());
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
