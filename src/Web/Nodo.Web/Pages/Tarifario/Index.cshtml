@page
@model Nodo.Web.Pages.Tarifario.IndexModel
@{
    ViewData["Title"] = "Tarifario";
}

<h2>Tarifario</h2>
<p>Usuario: @User.Identity?.Name | Rol: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>

<h3>Tarifarios</h3>
<table border="1">
    <tr><th>TarifarioId</th><th>Tarifas</th></tr>
    @foreach (var t in Model.Tarifarios)
    {
        <tr>
            <td>@t.Id</td>
            <td>
                <ul>
                    @foreach (var tarifa in t.Tarifas)
                    {
                        <li>@tarifa.Id - @tarifa.TipoRecurso - Pico:@tarifa.EsHoraPico - @tarifa.TarifaBase.Amount @tarifa.TarifaBase.Currency</li>
                    }
                </ul>
            </td>
        </tr>
    }
</table>

<h3>Actualizar tarifa (solo Dirección - INV-01)</h3>
<form method="post" asp-page-handler="Actualizar">
    <div>
        <label>TarifarioId</label>
        <input name="tarifarioId" />
    </div>
    <div>
        <label>TarifaId</label>
        <input name="tarifaId" />
    </div>
    <div>
        <label>Nuevo importe</label>
        <input name="nuevoImporte" type="number" step="0.01" />
    </div>
    <div>
        <label>Moneda</label>
        <input name="moneda" value="BOB" />
    </div>
    <button type="submit">Actualizar</button>
</form>

@if (Model.Mensaje != null)
{
    <p>@Model.Mensaje</p>
}
@if (Model.Error != null)
{
    <p style="color:red">@Model.Error</p>
}
